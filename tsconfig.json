{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["ClientApp/src/*"]
    },
    "types": [
      "vitest/globals",
      "trusted-types",
      "msw-storybook-addon/types"
    ],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleDetection": "force", // auto-detects modules without imports
    "verbatimModuleSyntax": true, // preserves exact import/export syntax
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "*.ts",
    "scripts/**/*.ts",
    "ClientApp/src/**/*",
    ".storybook/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "clientApp/src/api/web-api-client.ts",
    "ClientApp/src/main.*.js",
    "ClientApp/src/parent/node_modules",
    "ClientApp/src/parent/packages",
    "ClientApp/src/external",
    "ClientApp/source-map-http-downloads",
    "ClientApp/webpack",
    "node_modules",
    "dist",
    "storybook-static"
  ]
}
