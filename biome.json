{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",

			"!!**/dist",
			"!!**/build",
			"!!**/coverage",
			"!!**/storybook-static",

			"!!ClientApp/media",
			"!!ClientApp/source-map-http-downloads",

			"!ClientApp/src/external",
			"!ClientApp/src/parent/packages",
			"!ClientApp/src/api/web-api-client.ts",

			"!.github/migration-verifier/fixtures",
			"!.github/skills/**/assets",

			"!.claude/**/assets",
			"!.claude/**/references",
			"!.claude/docs",

			"!analysis/**/*.html",
			"!docs/change-record/**/*.html",

			"!**/*.svg"
		]
	},

	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"attributePosition": "auto",
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"delimiterSpacing": false,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
	{
		"includes": [
			"ClientApp/src/routes/acceptQuote/validation.ts",
			"ClientApp/src/routes/account/addBranch/validation.ts",
			"ClientApp/src/routes/account/update/validation.ts",
			"ClientApp/src/routes/account/validation.ts",
			"ClientApp/src/routes/requestForQuote/validation.ts",
			"ClientApp/src/routes/ta/validation.ts",
			"ClientApp/src/validationSchemas/addressValidation.ts"
		],
		"linter": {
			"rules": {
				"suspicious": {
					"noThenProperty": "off"
				}
			}
		}
	}
]
}
