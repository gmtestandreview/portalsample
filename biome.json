{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",

			"!!**/dist",
			"!!**/build",
			"!!**/coverage",
			"!!**/storybook-static",

			"!!ClientApp/media",
			"!!ClientApp/source-map-http-downloads",

			"!ClientApp/src/external",
			"!ClientApp/src/parent/packages",
			"!ClientApp/src/api/web-api-client.ts",

			"!.github/migration-verifier/fixtures",
			"!.github/skills/**/assets",

			"!.claude/**/assets",
			"!.claude/**/references",
			"!.claude/docs",

			"!analysis/**/*.html",
			"!docs/change-record/**/*.html",

			"!**/*.svg"
		]
	},

	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"attributePosition": "auto",
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noDivRegex": "error",
				"noUselessReturn": "error",
				"noUselessStringConcat": "error",
				"noUselessUndefined": "error",
				"useSimplifiedLogicExpression": "error",
				"useWhile": "error"
			},
			"correctness": {
				"noGlobalObjectCalls": "error",
				"noGlobalDirnameFilename": "error",
				"noProcessGlobal": "error",
				"useImportExtensions": "error",
				"useJsonImportAttributes": "error"
			},
			"nursery": {
				"noPlaywrightUselessAwait": "error",
				"noUnnecessaryTemplateExpression": "error",
				"useConsistentTestIt": "error",
				"useUnicodeRegex": "error",
				"useValidTestTitle": "off"
			},
			"style": {
				"noImplicitBoolean": "error",
				"noInferrableTypes": "error",
				"noNegationElse": "error",
				"noRestrictedTypes": "error",
				"noUnusedTemplateLiteral": "error",
				"noUselessElse": "error",
				"noYodaExpression": "error",
				"useAsConstAssertion": "error",
				"useCollapsedElseIf": "error",
				"useConsistentArrowReturn": "error",
				"useConsistentObjectDefinitions": "error",
				"useEnumInitializers": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": {
									"kind": "objectLiteralMember"
								},
								"match": "[$A-Za-z0-9_][$A-Za-z0-9_]*"
							},
							{
								"selector": {
									"kind": "typeMember"
								},
								"match": "[$A-Za-z0-9_][$A-Za-z0-9_]*"
							},
							{
								"selector": {
									"kind": "enumMember"
								},
								"formats": ["PascalCase", "CONSTANT_CASE"]
							}
						]
					}
				},
				"useNodeAssertStrict": "error",
				"useNumberNamespace": "error",
				"useNumericSeparators": "error",
				"useObjectSpread": "error",
				"useSelfClosingElements": "error",
				"useTrimStartEnd": "error"
			},
			"suspicious": {
				"useNumberToFixedDigitsArgument": "error",
				"useStrictMode": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"delimiterSpacing": false,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"ClientApp/src/routes/acceptQuote/validation.ts",
				"ClientApp/src/routes/account/addBranch/validation.ts",
				"ClientApp/src/routes/account/update/validation.ts",
				"ClientApp/src/routes/account/validation.ts",
				"ClientApp/src/routes/requestForQuote/validation.ts",
				"ClientApp/src/routes/ta/validation.ts",
				"ClientApp/src/validationSchemas/addressValidation.ts"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noThenProperty": "off"
					}
				}
			}
		}
	]
}
