{
  "threshold": 3,
  "path": ["ClientApp/src", "tests"],
  "ignore": [
    "**/node_modules/**",
    "**/*.min.js",
    "**/coverage/**",
    "**/web-api-client*",
    "**/target/**",
    "**/.git/**",
    "**/.tokensave/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/*.min.*",
    "**/build/**",
    "**/out/**",
    "**/.gradle/**",
    "**/site-packages/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "bin/**",
    "ClientApp/css/main.*.css",
    "ClientApp/css/main.*.css.map",
    "ClientApp/src/main.*.js",
    "ClientApp/src/main.*.js.map",
    "**/example-codeql-db/**",
    "**/esprint.json",
    "**/eslint-*-effective.json",
    "**/dist/**",
    "**/storybook-static/**",
    "**/.npm-cache/**",
    "**/*.tsbuildinfo",
    "**/.vitest/**",
    "**/tmp/**",
    "**/.features-gen/**",
    "**/.playwright-mcp/**",
    "**/.testagent/**",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/npm-debug.log*",
    "**/*.log",
    "**/.claude/settings.local.json",
    "**/.claude/settings.local.json.*.bak",
    "**/.claude/settings.local.json.*.tmp",
    "**/.scannerwork/",
    "**/.lsmcp/cache",
    "**/.ruff_cache/",
    "**/.mypy_cache/",
    "**/.pytest_cache/",
    "**/*.info",
    "**/*.bak",
    "**/*.tmp",
    "**/*.swp",
    "**/*.swo",
    "**/excalidraw/**",
    "**/drawio/**",
    "**/*.rel.**",
    "**/*.meta",
    "**/*.diff",
    "**/*.tag",
    "**/*.1",
    "**/*.exit",
    "**/*.pid",
    "**/*.ics",
    "**/*.sha256",
    "**/*.stats",
    "**/*.tag",
    "**/*.patch",
     ".claude",
    ".claude/**",
    ".copilot-tracking",
    ".copilot-tracking/**",
    ".github",
    ".github/**",
    ".agents",
    ".agents/**",
    ".agent-sync",
    ".agent-sync/**",
    ".storybook",
    ".storybook/**",
    ".codex",
    ".codex/**",
    ".superpowers",
    ".superpowers/**",
    "**/*.stories.*"

  ],
  "format": ["javascript", "jsx", "typescript", "tsx", "python"],
  "minTokens": 50,
  "minLines": 5,
  "reporters": ["console", "html", "json", "ai"],
  "output": "report"
}
