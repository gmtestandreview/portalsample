{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nmi-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"ClientApp/src/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx,js,jsx}\" \"tests/**/*.{ts,tsx}\" \"*.config.{ts,js}\" \"vitest*.{ts,js}\"",
    "lint:mdx": "remark \".storybook/**/*.mdx\" \"ClientApp/src/**/*.mdx\" --frail",
    "lint:rules": "node scripts/verify-rule-citations.mjs",
    "lint:rules:fix": "node scripts/verify-rule-citations.mjs --fix",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --config vitest.unit.config.ts",
    "test:unit:coverage": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --config vitest.unit.config.ts --coverage",
    "test:unit:watch": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs --config vitest.unit.config.ts",
    "test:storybook": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --config vitest.storybook.config.ts",
    "test:storybook:watch": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs --config vitest.storybook.config.ts",
    "test:all": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run",
    "test:quality:regression": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --config quality/vitest.regression.config.ts",
    "test:ci": "npm run type-check && npm run test:ci:unit && npm run test:ci:storybook && npm run test:ci:quality",
    "test:ci:unit": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --config vitest.unit.config.ts --coverage --reporter=default --reporter=junit --outputFile.junit=reports/vitest/unit-junit.xml",
    "test:ci:storybook": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --config vitest.storybook.config.ts --reporter=default --reporter=junit --outputFile.junit=reports/vitest/storybook-junit.xml",
    "test:ci:quality": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --config quality/vitest.regression.config.ts --reporter=default --reporter=junit --outputFile.junit=reports/vitest/quality-junit.xml",
    "storybook": "storybook dev -p 6006",
    "clean:storybook-output": "node scripts/clean-storybook-output.mjs",
    "build-storybook": "npm run clean:storybook-output && storybook build -o storybook-static",
    "storybook:docs": "storybook dev -p 6006 --docs",
    "storybook:build:docs": "storybook build --docs -o storybook-static",
    "storybook:verify:docs": "npm run storybook:build:docs && node scripts/verify-storybook-docs.mjs",
    "build-storybook-docs": "npm run storybook:build:docs",
    "storybook-docs": "npm run storybook:docs",
    "test:e2e": "npm run test:e2e:app && npm run test:e2e:storybook",
    "test:e2e:app": "bddgen -c playwright.config.ts && playwright test -c playwright.config.ts --project=app-bdd",
    "test:e2e:storybook": "bddgen -c playwright.storybook.config.ts && playwright test -c playwright.storybook.config.ts --project=storybook-bdd",
    "test:e2e:ui": "bddgen -c playwright.config.ts && playwright test -c playwright.config.ts --project=app-bdd --ui",
    "test:e2e:debug": "bddgen -c playwright.config.ts && playwright test -c playwright.config.ts --project=app-bdd --debug",
    "test:e2e:report": "playwright show-report reports/playwright/app",
    "test:bdd": "npm run test:e2e",
    "test:bdd:ui": "npm run test:e2e:ui",
    "migration-check": "tsc --noEmit && node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run && npm run clean:storybook-output && storybook build -o storybook-static",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.30.0",
    "@azure/msal-react": "^2.2.0",
    "@microsoft/applicationinsights-common": "^3.4.2",
    "@microsoft/applicationinsights-react-js": "^3.4.3",
    "@microsoft/applicationinsights-web": "^3.4.2",
    "@popperjs/core": "^2.11.8",
    "@react-aria/optimize-locales-plugin": "^2.0.0",
    "bootstrap": "^5.3.8",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.14",
    "formik": "^2.4.9",
    "html-react-parser": "^6.1.3",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-aria-components": "^1.19.0",
    "react-bootstrap": "^2.10.10",
    "react-datepicker": "^7.6.0",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-ga4": "^2.1.0",
    "react-number-format": "^5.4.5",
    "react-router": "^7.18.2",
    "slate": "^0.124.1",
    "slate-react": "^0.124.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "7.8.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "chromatic": "^18.5.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "17.11.0",
    "html-webpack-plugin": "^5.6.7",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "mockdate": "^3.0.5",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^3.0.0",
    "patch-package": "^8.0.0",
    "playwright-bdd": "^9.2.0",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "sass": "^1.101.0",
    "sass-loader": "^14.2.1",
    "semver": "7.8.5",
    "storybook": "10.5.10",
    "style-loader": "^4.0.0",
    "syncpack": "^15.3.2",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "^8.1.0",
    "vitest": "4.1.11",
    "webpack": "^5.108.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.5"
  },
  "msw": {
    "workerDirectory": [
      "ClientApp/public"
    ]
  },
  "overrides": {
    "@npmcli/map-workspaces": {
      "glob": "13.0.6"
    },
    "@npmcli/package-json": {
      "glob": "13.0.6"
    },
    "body-parser": "1.20.6",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "browserslist": "4.28.8",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "qs": "6.16.0",
    "undici": "7.29.0",
    "unified-engine": {
      "glob": "13.0.6"
    },
    "uuid": "^11.1.1",
    "valibot": "1.4.2"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "msw": true
  }
}
