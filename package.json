{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nmi-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "verify:vite-build": "npm run build && node scripts/verify-vite-build.mjs",
    "verify:vite-runtime": "node scripts/verify-vite-runtime.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"ClientApp/src/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx,js,jsx}\" \"tests/**/*.{ts,tsx}\" \"*.config.{ts,mts,js}\" \"vite.config.mts\" \"scripts/verify-vite-build.mjs\" \"scripts/verify-vite-runtime.mjs\" \"scripts/storybook-coverage.mjs\" \"scripts/storybook-coverage-worklist.mjs\" \"scripts/verify-storybook-docs.mjs\" \"scripts/storybook-closure.mjs\" \"vitest*.{ts,js}\"",
    "lint:mdx": "remark \".storybook/**/*.mdx\" \"ClientApp/src/**/*.mdx\" --frail",
    "lint:rules": "node scripts/verify-rule-citations.mjs",
    "lint:rules:fix": "node scripts/verify-rule-citations.mjs --fix",
    "validate:json": "node scripts/validate-json.mjs",
    "sonar:backlog": "node scripts/sonar-issues-backlog.mjs",
    "sonar:backlog:test-fixture": "node scripts/sonar-issues-backlog.mjs --fixture tests/fixtures/sonar --out analysis/sonar-issues-backlog.md",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner --config vitest.unit.config.ts",
    "test:unit:coverage": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner --config vitest.unit.config.ts --coverage",
    "test:unit:watch": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs --watch --configLoader runner --config vitest.unit.config.ts",
    "test:storybook": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner --config vitest.storybook.config.ts",
    "test:storybook:watch": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs --watch --configLoader runner --config vitest.storybook.config.ts",
    "test:storybook:coverage": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner --config vitest.storybook.config.ts --coverage",
    "test:all": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner",
    "test:quality:regression": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner --config quality/vitest.regression.config.ts",
    "test:ci": "npm run type-check && npm run test:ci:unit && npm run test:ci:storybook && npm run test:ci:quality",
    "test:ci:unit": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner --config vitest.unit.config.ts --coverage --reporter=default --reporter=junit --outputFile.junit=reports/vitest/unit-junit.xml",
    "test:ci:storybook": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner --config vitest.storybook.config.ts --reporter=default --reporter=junit --outputFile.junit=reports/vitest/storybook-junit.xml",
    "test:ci:quality": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner --config quality/vitest.regression.config.ts --reporter=default --reporter=junit --outputFile.junit=reports/vitest/quality-junit.xml",
    "storybook": "node --max-old-space-size=8192 ./node_modules/storybook/dist/bin/dispatcher.js dev -p 6006",
    "clean:storybook-output": "node scripts/clean-storybook-output.mjs",
    "build-storybook": "npm run clean:storybook-output && node --max-old-space-size=8192 scripts/run-storybook-build.mjs build -o storybook-static",
    "storybook:docs": "node --max-old-space-size=8192 ./node_modules/storybook/dist/bin/dispatcher.js dev -p 6006 --docs",
    "storybook:build:docs": "node --max-old-space-size=8192 scripts/run-storybook-build.mjs build --docs -o storybook-static",
    "storybook:verify:docs": "npm run storybook:build:docs && node scripts/verify-storybook-docs.mjs",
    "build-storybook-docs": "npm run storybook:build:docs",
    "storybook-docs": "npm run storybook:docs",
    "test:e2e": "npm run test:e2e:app && npm run test:e2e:storybook:closure",
    "test:api-contract": "node scripts/run-api-contract-tests.mjs",
    "test:e2e:app": "bddgen -c playwright.config.ts && playwright test -c playwright.config.ts --project=app-bdd",
    "test:e2e:storybook": "bddgen -c playwright.storybook.config.ts && playwright test -c playwright.storybook.config.ts --project=storybook-bdd",
    "test:e2e:storybook:closure": "node scripts/storybook-closure.mjs --checkout . --url http://localhost:6007 --server-mode managed --receipts reports/storybook-coverage/closure-run --mcp-timeout-ms 3600000",
    "test:e2e:ui": "bddgen -c playwright.config.ts && playwright test -c playwright.config.ts --project=app-bdd --ui",
    "test:e2e:debug": "bddgen -c playwright.config.ts && playwright test -c playwright.config.ts --project=app-bdd --debug",
    "test:e2e:report": "playwright show-report reports/playwright/app",
    "test:bdd": "npm run test:e2e",
    "test:bdd:ui": "npm run test:e2e:ui",
    "migration-check": "tsc --noEmit && node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --configLoader runner && npm run clean:storybook-output && node --max-old-space-size=8192 ./node_modules/storybook/dist/bin/dispatcher.js build -o storybook-static",
    "postinstall": "node scripts/apply-local-patches.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.26.0",
    "@azure/msal-react": "^5.7.3",
    "@microsoft/applicationinsights-common": "^3.4.5",
    "@microsoft/applicationinsights-react-js": "^18.3.6",
    "@microsoft/applicationinsights-web": "^3.4.5",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.4.0",
    "dompurify": "3.4.17",
    "formik": "^2.4.9",
    "html-react-parser": "^6.1.9",
    "react": "^18.3.1",
    "react-aria-components": "^1.22.1",
    "react-bootstrap": "^2.10.10",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.6",
    "react-ga4": "^3.0.1",
    "react-hook-form": "^7.90.0",
    "react-number-format": "^5.4.5",
    "react-router": "^7.18.4",
    "slate": "^0.146.0",
    "slate-dom": "^0.147.3",
    "slate-react": "^0.147.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint-react/eslint-plugin": "5.28.5",
    "@eslint/js": "10.0.1",
    "@mizchi/lsmcp": "^0.10.0",
    "@playwright/test": "1.64.1",
    "@react-aria/mcp": "1.2.1",
    "@react-aria/test-utils": "^1.0.0-rc.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-links": "10.6.3",
    "@storybook/addon-mcp": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "1.6.27",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "braces": "file:vendor/braces",
    "chromatic": "18.13.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-storybook": "10.6.3",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "mockdate": "^3.0.5",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-markdown-html": "^1.6.1",
    "pyright": "^1.1.414",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "sass": "^1.106.1",
    "semver": "7.8.5",
    "storybook": "10.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0",
    "typescript-language-server": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "4.1.12",
    "playwright": "1.64.1"
  },
  "msw": {
    "workerDirectory": ["ClientApp/public", "storybook-static"]
  },
  "overrides": {
    "@mizchi/lsmcp": {
      "glob": "13.0.6"
    },
    "@npmcli/map-workspaces": {
      "glob": "13.0.6"
    },
    "@npmcli/package-json": {
      "glob": "13.0.6"
    },
    "unified-engine": {
      "glob": "13.0.6"
    }
  },
  "packageManager": "npm@11.19.1+sha512.cedb312b1b7f92421a02cfb68b4194e88f8346651dacd6acc5364a25ef5309d4a32b19616a1ff8aff865e7280c0fa5c0835a99f5cd93368991e2a80ec9da75d2",
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "msw": true
  }
}
