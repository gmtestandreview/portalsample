# Dependencies
node_modules/
.npm-cache/

# Build output
dist/
storybook-static/

# Compiled artifacts (webpack outputs to dist/, not ClientApp/)
ClientApp/css/main.*.css
ClientApp/css/main.*.css.map
ClientApp/src/main.*.js
ClientApp/src/main.*.js.map

# TypeScript
*.tsbuildinfo

# Test output (all artifacts consolidated under reports/)
reports/
coverage/
tmp/

# `coverage/` matches by basename at any depth, so it also swallowed
# tests/unit/coverage/ — test SOURCE, not output. Re-include that directory.
!tests/unit/coverage/
!tests/unit/coverage/**

# quality/ is mostly local analysis output (BUGS.md, code_reviews/, generated
# grids and reports) and stays ignored — but two files in it are CI-critical
# SOURCE: `npm run test:ci:quality` loads the config, which includes the only
# test file it runs. While the whole directory was ignored, a fresh clone could
# not run that script at all, so the vitest-quality required status could never
# pass in CI. Ignore the contents rather than the directory, because git will not
# descend into an excluded directory and a negation inside one has no effect.
quality/*
!quality/vitest.regression.config.ts
!quality/test_regression.ts
.features-gen/
.playwright-mcp/
.testagent/

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
*.log
full-test-output.txt
test-output.txt
test_output.txt

# Claude Code configuration for this project stays per-developer. Both files
# hold permission grants - settings.json is a Bash/tool allowlist and
# settings.local.json adds machine-specific absolute paths - and a standing
# pre-approval that is right for one developer's workflow is not automatically
# right for everyone who clones. Neither is tracked; agree changes in review
# rather than inheriting them silently.
.claude/settings.json
.claude/settings.local.json
