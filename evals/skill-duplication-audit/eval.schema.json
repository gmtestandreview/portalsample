{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.local/skill-eval/eval.schema.json",
  "title": "Skill eval suite (copilot-sdk executor)",
  "description": "Top-level eval.yaml for a skill trigger/behaviour eval. Reverse-engineered from the observed grammar; additionalProperties is left open so unknown-but-valid keys are not flagged.",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "skill", "tasks"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "skill": { "type": "string", "description": "Name of the skill under test." },
    "version": { "type": "string" },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "trials_per_task": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "parallel": { "type": "boolean" },
        "executor": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "graders": { "$ref": "#/definitions/graders" },
    "tasks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Globs, relative to this file, matching task YAML files."
    }
  },
  "definitions": {
    "graders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "name": { "type": "string" },
          "config": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "contains": { "type": "array", "items": { "type": "string" } },
              "not_contains": { "type": "array", "items": { "type": "string" } },
              "max_tokens": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
