{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["index.{js,ts}", "scripts/*.ts", "src/index.{js,ts}"],
  "project": ["**/*.{js,ts}"],
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  "tags": [
    "-lintignore"
  ],
  "playwright": true,
  "webpack": false,
  "eslint": {
    "config": [
      "eslint.config.mjs",
      ".eslintrc",
      ".eslintrc.{js,json,cjs}",
      ".eslintrc.{yml,yaml}",
      "package.json"
    ]
  }
}