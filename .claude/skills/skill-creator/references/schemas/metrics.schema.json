{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "metrics.schema.json",
	"title": "Skill Creator Executor Metrics",
	"type": "object",
	"minProperties": 1,
	"properties": {
		"tool_calls": {
			"type": "object",
			"additionalProperties": {
				"type": "integer",
				"minimum": 0
			}
		},
		"total_tool_calls": {
			"type": "integer",
			"minimum": 0
		},
		"total_steps": {
			"type": "integer",
			"minimum": 0
		},
		"files_created": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"errors_encountered": {
			"type": "integer",
			"minimum": 0
		},
		"output_chars": {
			"type": "integer",
			"minimum": 0
		},
		"transcript_chars": {
			"type": "integer",
			"minimum": 0
		}
	},
	"additionalProperties": false
}
