{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evals.schema.json",
  "title": "Skill Creator Evals",
  "type": "object",
  "required": [
    "skill_name",
    "evals"
  ],
  "properties": {
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "expected_output"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected_output": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expectations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
