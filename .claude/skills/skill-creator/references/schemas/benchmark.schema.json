{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark.schema.json",
  "title": "Skill Creator Benchmark",
  "type": "object",
  "required": [
    "metadata",
    "runs",
    "run_summary",
    "notes"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "skill_name",
        "skill_path",
        "executor_model",
        "analyzer_model",
        "timestamp",
        "evals_run",
        "runs_per_configuration"
      ],
      "properties": {
        "skill_name": {
          "type": "string",
          "minLength": 1
        },
        "skill_path": {
          "type": "string",
          "minLength": 1
        },
        "executor_model": {
          "type": "string",
          "minLength": 1
        },
        "analyzer_model": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "evals_run": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evalId"
          },
          "uniqueItems": true
        },
        "runs_per_configuration": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison_pair": {
          "$ref": "common.schema.json#/$defs/comparisonPair"
        }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "eval_id",
          "eval_name",
          "configuration",
          "run_number",
          "result",
          "expectations",
          "notes"
        ],
        "properties": {
          "eval_id": {
            "$ref": "common.schema.json#/$defs/evalId"
          },
          "eval_name": {
            "type": "string",
            "minLength": 1
          },
          "configuration": {
            "$ref": "common.schema.json#/$defs/configuration"
          },
          "run_number": {
            "type": "integer",
            "minimum": 1
          },
          "result": {
            "type": "object",
            "required": [
              "pass_rate",
              "passed",
              "failed",
              "total"
            ],
            "properties": {
              "pass_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "time_seconds": {
                "type": "number",
                "minimum": 0
              },
              "tokens": {
                "type": "number",
                "minimum": 0
              },
              "tool_calls": {
                "type": "integer",
                "minimum": 0
              },
              "errors": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "expectations": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/expectationResult"
            }
          },
          "notes": {
            "type": "array",
            "items": {}
          }
        },
        "additionalProperties": false
      }
    },
    "run_summary": {
      "type": "object",
      "properties": {
        "with_skill": {
          "$ref": "#/$defs/configSummary"
        },
        "without_skill": {
          "$ref": "#/$defs/configSummary"
        },
        "new_skill": {
          "$ref": "#/$defs/configSummary"
        },
        "old_skill": {
          "$ref": "#/$defs/configSummary"
        },
        "delta": {
          "$ref": "#/$defs/deltaSummary"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "with_skill"
          ]
        },
        {
          "required": [
            "without_skill"
          ]
        },
        {
          "required": [
            "new_skill"
          ]
        },
        {
          "required": [
            "old_skill"
          ]
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "configSummary": {
      "type": "object",
      "required": [
        "pass_rate"
      ],
      "properties": {
        "pass_rate": {
          "$ref": "common.schema.json#/$defs/stats"
        },
        "time_seconds": {
          "$ref": "common.schema.json#/$defs/stats"
        },
        "tokens": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/stats"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "deltaSummary": {
      "type": "object",
      "properties": {
        "pass_rate": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_seconds": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
