{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "timing.schema.json",
	"title": "Skill Creator Timing",
	"type": "object",
	"minProperties": 1,
	"properties": {
		"total_tokens": {
			"type": "integer",
			"minimum": 0
		},
		"duration_ms": {
			"type": "number",
			"minimum": 0
		},
		"total_duration_seconds": {
			"type": "number",
			"minimum": 0
		},
		"executor_start": {
			"type": "string",
			"format": "date-time"
		},
		"executor_end": {
			"type": "string",
			"format": "date-time"
		},
		"executor_duration_seconds": {
			"type": "number",
			"minimum": 0
		},
		"grader_start": {
			"type": "string",
			"format": "date-time"
		},
		"grader_end": {
			"type": "string",
			"format": "date-time"
		},
		"grader_duration_seconds": {
			"type": "number",
			"minimum": 0
		}
	},
	"additionalProperties": false
}
