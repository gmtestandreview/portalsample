{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis.schema.json",
  "title": "Skill Creator Post-hoc Analysis",
  "type": "object",
  "required": [
    "comparison_summary",
    "winner_strengths",
    "loser_weaknesses",
    "instruction_following",
    "improvement_suggestions",
    "transcript_insights"
  ],
  "properties": {
    "comparison_summary": {
      "type": "object",
      "required": [
        "winner",
        "winner_skill",
        "loser_skill",
        "comparator_reasoning"
      ],
      "properties": {
        "winner": {
          "type": "string",
          "enum": ["A", "B"]
        },
        "winner_skill": {
          "type": "string",
          "minLength": 1
        },
        "loser_skill": {
          "type": "string",
          "minLength": 1
        },
        "comparator_reasoning": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "winner_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loser_weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instruction_following": {
      "type": "object",
      "required": ["winner", "loser"],
      "properties": {
        "winner": {
          "$ref": "#/$defs/instructionSide"
        },
        "loser": {
          "$ref": "#/$defs/instructionSide"
        }
      },
      "additionalProperties": false
    },
    "improvement_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "category", "suggestion", "expected_impact"],
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          },
          "expected_impact": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "transcript_insights": {
      "type": "object",
      "required": ["winner_execution_pattern", "loser_execution_pattern"],
      "properties": {
        "winner_execution_pattern": {
          "type": "string"
        },
        "loser_execution_pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "instructionSide": {
      "type": "object",
      "required": ["score", "issues"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
