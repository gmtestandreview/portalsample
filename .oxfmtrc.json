{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "quoteProps": "as-needed",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "proseWrap": "always",
  "arrowParens": "always",
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": false,
  "sortPackageJson": true,
  "overrides": [
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2
      }
    }
  ],
  "associations": [
    {
      "files": ["*.js", "*.mjs"],
      "language": "javascript"
    },
    {
      "files": ["*.jsx"],
      "language": "jsx"
    },
    {
      "files": ["*.ts"],
      "language": "typescript"
    },
    {
      "files": ["*.tsx"],
      "language": "tsx"
    },
    {
      "files": ["*.scss"],
      "language": "scss"
    },
    {
      "files": ["*.css"],
      "language": "css"
    },
    {
      "files": ["*.graphql", "*.gql"],
      "language": "graphql"
    },
    {
      "files": ["*.md", "*.markdown"],
      "language": "markdown"
    },
    {
      "files": ["*.mdx"],
      "language": "mdx"
    },
    {
      "files": ["*.yml", "*.yaml"],
      "language": "yaml"
    },
    {
      "files": ["*.html", "*.htm"],
      "language": "html"
    },
    {
      "files": ["*.json"],
      "language": "json"
    }
  ],
  "ignorePatterns": [
    "build",
    "coverage",
    "dist",
    "node_modules",
    "storybook-static",
    "reports",
    "test-results",
    "playwright-report",
    ".tokensave",
    "ClientApp/media",
    "ClientApp/src/api/web-api-client.ts",
    "vendor",
    ".github/migration-verifier",
    ".github/skills",
    ".claude",
    ".agents",
    ".codex",
    ".superpowers",
    ".tours",
    "evals",
    "hooks",
    "plugins",
    "skills",
    "templates",
    "eslint-actual-results.json",
    "eslint-configs.-policy.json",
    "package-lock.json"
  ]
}
